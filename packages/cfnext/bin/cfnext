#!/usr/bin/env bash
set -euo pipefail
# Resolve symlinks (npm/bun install the bin via node_modules/.bin).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
if [[ -x "$ROOT/dist/bin/cfnext" ]]; then
  exec "$ROOT/dist/bin/cfnext" "$@"
fi
exec bun "$ROOT/src/cli/index.ts" "$@"
