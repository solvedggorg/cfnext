{
  "name": "cfnext",
  "version": "0.7.2",
  "type": "module",
  "description": "Next.js adapter and CLI for Cloudflare Workers compute and Containers (D1, R2, KV, and more). Bun-first. No OpenNext.",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "bin": {
    "cfnext": "./bin/cfnext"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "bun": "./src/adapter.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    },
    "./worker": {
      "types": "./dist/worker/assets.d.ts",
      "bun": "./src/worker/assets.ts",
      "import": "./dist/worker/assets.js",
      "default": "./dist/worker/assets.js"
    },
    "./worker/container": {
      "types": "./dist/worker/container.d.ts",
      "bun": "./src/worker/container.ts",
      "import": "./dist/worker/container.js",
      "default": "./dist/worker/container.js"
    },
    "./worker/ssr": {
      "types": "./dist/worker/ssr.d.ts",
      "bun": "./src/worker/ssr.ts",
      "import": "./dist/worker/ssr.js",
      "default": "./dist/worker/ssr.js"
    },
    "./worker/compose": {
      "types": "./dist/worker/compose.d.ts",
      "bun": "./src/worker/compose.ts",
      "import": "./dist/worker/compose.js",
      "default": "./dist/worker/compose.js"
    },
    "./server": {
      "types": "./dist/ssr/context.d.ts",
      "bun": "./src/ssr/context.ts",
      "import": "./dist/ssr/context.js",
      "default": "./dist/ssr/context.js"
    },
    "./protect": {
      "types": "./dist/protect.d.ts",
      "bun": "./src/protect.ts",
      "import": "./dist/protect.js",
      "default": "./dist/protect.js"
    },
    "./protect/clerk": {
      "types": "./dist/protect-clerk.d.ts",
      "bun": "./src/protect-clerk.ts",
      "import": "./dist/protect-clerk.js",
      "default": "./dist/protect-clerk.js"
    },
    "./access": {
      "types": "./dist/server/access.d.ts",
      "bun": "./src/server/access.ts",
      "import": "./dist/server/access.js",
      "default": "./dist/server/access.js"
    },
    "./flags": {
      "types": "./dist/server/flags.d.ts",
      "bun": "./src/server/flags.ts",
      "import": "./dist/server/flags.js",
      "default": "./dist/server/flags.js"
    },
    "./analytics": {
      "types": "./dist/analytics/web.d.ts",
      "bun": "./src/analytics/web.ts",
      "import": "./dist/analytics/web.js",
      "default": "./dist/analytics/web.js"
    },
    "./email": {
      "types": "./dist/server/email.d.ts",
      "bun": "./src/server/email.ts",
      "import": "./dist/server/email.js",
      "default": "./dist/server/email.js"
    },
    "./ai": {
      "types": "./dist/server/ai.d.ts",
      "bun": "./src/server/ai.ts",
      "import": "./dist/server/ai.js",
      "default": "./dist/server/ai.js"
    },
    "./image-loader": {
      "types": "./dist/image-loader.d.ts",
      "bun": "./src/image-loader.ts",
      "import": "./dist/image-loader.js",
      "default": "./dist/image-loader.js"
    },
    "./stream": {
      "types": "./dist/media/stream.d.ts",
      "bun": "./src/media/stream.ts",
      "import": "./dist/media/stream.js",
      "default": "./dist/media/stream.js"
    },
    "./schema": {
      "default": "./schema/cfnext.schema.json"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "schema",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun src/build/emit-declarations.ts",
    "compile": "bun src/build/compile-cli.ts",
    "test": "bun test",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "peerDependencies": {
    "@cloudflare/containers": "^0.0.28 || ^0.3.0",
    "next": ">=16.2.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "wrangler": ">=4.0.0",
    "@cloudflare/flagship": ">=0.1.0",
    "@openfeature/server-sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/containers": {
      "optional": true
    },
    "@cloudflare/flagship": {
      "optional": true
    },
    "@openfeature/server-sdk": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "ajv": "8",
    "ajv-formats": "3",
    "typescript": "^7.0.0"
  }
}
